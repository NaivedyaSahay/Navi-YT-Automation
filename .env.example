# ─── Required ────────────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here

# ─── Optional: Stock footage APIs (leave blank to use animated background) ───
PEXELS_API_KEY=
PIXABAY_API_KEY=

# ─── Gemini model (options: gemini-3.6-flash, gemini-2.0-flash) ───────────────
GEMINI_MODEL=gemini-3.6-flash

# ─── Edge TTS voice ───────────────────────────────────────────────────────────
# List all voices: python -c "from voice_generator import list_voices; list_voices()"
TTS_VOICE=en-US-ChristopherNeural
TTS_RATE=+0%
TTS_VOLUME=+0%

# ─── Video output settings ────────────────────────────────────────────────────
VIDEO_WIDTH=1080
VIDEO_HEIGHT=1920
VIDEO_FPS=30
VIDEO_CODEC=libx264
AUDIO_CODEC=aac
VIDEO_BITRATE=4000k
OUTPUT_DIR=output

# ─── YouTube Upload Defaults ──────────────────────────────────────────────────
CLIENT_SECRETS_FILE=client_secrets.json
TOKEN_FILE=token.json
DEFAULT_PRIVACY_STATUS=unlisted
# YouTube Category IDs: 22=People & Blogs, 24=Entertainment, 28=Science & Tech
DEFAULT_CATEGORY_ID=22
