# ─── Required ────────────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here

# ─── Optional: Stock footage APIs (leave blank to use animated background) ───
PEXELS_API_KEY=
PIXABAY_API_KEY=

# ─── Gemini model (free tier options: gemini-1.5-flash, gemini-2.0-flash) ────
GEMINI_MODEL=gemini-1.5-flash

# ─── Edge TTS voice ───────────────────────────────────────────────────────────
# List all voices: python -c "from voice_generator import list_voices; list_voices()"
TTS_VOICE=en-US-ChristopherNeural
TTS_RATE=+0%
TTS_VOLUME=+0%

# ─── Video output settings ────────────────────────────────────────────────────
VIDEO_WIDTH=1080
VIDEO_HEIGHT=1920
VIDEO_FPS=30
VIDEO_CODEC=libx264
AUDIO_CODEC=aac
VIDEO_BITRATE=4000k
OUTPUT_DIR=output

# ─── YouTube Upload Defaults ──────────────────────────────────────────────────
CLIENT_SECRETS_FILE=client_secrets.json
TOKEN_FILE=token.json
DEFAULT_PRIVACY_STATUS=unlisted
# YouTube Category IDs: 22=People & Blogs, 24=Entertainment, 28=Science & Tech
DEFAULT_CATEGORY_ID=22

# ─── Multi-Platform Publishing Targets ───────────────────────────────────────
# Options: youtube, pinterest, facebook, instagram, x, threads
ENABLED_PLATFORMS=youtube,pinterest,facebook,instagram,x,threads

# Meta (Facebook & Instagram)
FB_PAGE_ID=your_facebook_page_id_here
FB_PAGE_ACCESS_TOKEN=your_facebook_page_access_token_here
IG_USER_ID=your_instagram_business_account_id_here
IG_ACCESS_TOKEN=your_instagram_access_token_here

# Meta Threads
THREADS_USER_ID=your_threads_user_id_here
THREADS_ACCESS_TOKEN=your_threads_access_token_here

# X (Twitter)
TWITTER_API_KEY=your_twitter_api_key_here
TWITTER_API_SECRET=your_twitter_api_secret_here
TWITTER_ACCESS_TOKEN=your_twitter_access_token_here
TWITTER_ACCESS_TOKEN_SECRET=your_twitter_access_token_secret_here
TWITTER_BEARER_TOKEN=your_twitter_bearer_token_here

# Pinterest
PINTEREST_ACCESS_TOKEN=your_pinterest_access_token_here
PINTEREST_BOARD_ID=your_pinterest_board_id_here

